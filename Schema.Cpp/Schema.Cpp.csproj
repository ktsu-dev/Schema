<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <!-- One framework short of the library this extends. ktsu.Coder ships no net8.0 assembly, and
         the C++ generator is built on its AST, so this is the framework floor the dependency sets
         rather than a choice. Keeping the generator here is what lets ktsu.Schema go on publishing
         net8.0 for everyone who only defines and reads schemas, and is why SchemaGenerator.Register
         exists. -->
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schema\Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reflection vocabulary is C++ this project ships rather than generates: a template
         parameter list and a concept are things the AST deliberately cannot say, so the file is
         substituted rather than built. -->
    <EmbeddedResource Include="Prelude\*.hpp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ktsu.Coder" />
    <!-- The name types a schema element carries are semantic strings, so reading one is a direct
         use of the package that declares them rather than an incidental one. -->
    <PackageReference Include="ktsu.Semantics.Strings" />
    <!-- The dimension a reflection table carries is the unit's own, read off the registry rather
         than restated here, which is a direct use of the package that declares units. -->
    <PackageReference Include="ktsu.Semantics.Quantities" />
    <!-- The reflection vocabulary's TypeKind is every [JsonDerivedType] on BaseType, read off the
         attribute itself. On net10.0 that type is the shared framework's and needs no reference;
         on net9.0 it arrives transitively, which is a package this project uses directly. -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.AzureRepos.Git" PrivateAssets="All" />
  </ItemGroup>
</Project>
